    {
      "key": "Sandbox_VehicleLivingSlots_FridgePowerConsumption_tooltip",
      "en": "Displayed at 1000 times the fridge's actual auxiliary-battery drain per game minute. Default: 0.04, giving about 17.36 game days on a full battery. Minimum: 0.01. A charged auxiliary battery is required.",
      "cn": "冰箱每游戏分钟实际耗电量的 1000 倍显示值。默认 0.04，满电约可持续 17.36 个游戏日；最小 0.01，须安装有电的副电瓶。",
      "ch": "冰箱每遊戲分鐘實際耗電量的 1000 倍顯示值。預設 0.04，滿電約可持續 17.36 個遊戲日；最小 0.01，須安裝有電的副電瓶。",
      "reviewed": true,
      "runtime_group": "workshop/Contents/mods/VehicleLivingSlots/common/media/lua/shared/Translate/{LOCALE}/Sandbox.json"
    },
    {
      "key": "Sandbox_VehicleLivingSlots_MicrowavePowerConsumption",
      "en": "Microwave power consumption",
      "cn": "微波炉耗电量",
      "ch": "微波爐耗電量",
      "reviewed": true,
      "runtime_group": "workshop/Contents/mods/VehicleLivingSlots/common/media/lua/shared/Translate/{LOCALE}/Sandbox.json"
    },
    {
      "key": "Sandbox_VehicleLivingSlots_MicrowavePowerConsumption_tooltip",
      "en": "Displayed at 1000 times the microwave's actual auxiliary-battery drain per active game minute. Default: 0.4, ten times the fridge rate. Minimum: 0.01. A charged auxiliary battery is required.",
      "cn": "微波炉工作时每游戏分钟实际耗电量的 1000 倍显示值。默认 0.4，是冰箱的 10 倍；最小 0.01，须安装有电的副电瓶。",
      "ch": "微波爐工作時每遊戲分鐘實際耗電量的 1000 倍顯示值。預設 0.4，是冰箱的 10 倍；最小 0.01，須安裝有電的副電瓶。",
      "reviewed": true,
      "runtime_group": "workshop/Contents/mods/VehicleLivingSlots/common/media/lua/shared/Translate/{LOCALE}/Sandbox.json"
    },
